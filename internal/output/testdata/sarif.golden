{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "decloak",
          "informationUri": "https://github.com/dorgrn/decloak",
          "version": "dev",
          "rules": [
            {
              "id": "PY-EXEC-001",
              "shortDescription": {
                "text": "exec of decoded payload"
              },
              "help": {
                "text": "Remove dynamic execution of decoded data."
              }
            },
            {
              "id": "MD-INJ-001",
              "shortDescription": {
                "text": "hidden HTML comment directive"
              },
              "help": {
                "text": "Remove concealed instructions."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY-EXEC-001",
          "level": "error",
          "message": {
            "text": "exec of decoded payload"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3,
                  "startColumn": 1,
                  "endColumn": 25,
                  "snippet": {
                    "text": "exec(b64decode(blob))"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "MD-INJ-001",
          "level": "warning",
          "message": {
            "text": "hidden HTML comment directive"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SKILL.md"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 12,
                  "startColumn": 1,
                  "endColumn": 4,
                  "snippet": {
                    "text": "\u003c!-- ignore previous instructions --\u003e"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
